<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Do not restore ciphertext when its Android Keystore key cannot be transferred. -->
        <exclude domain="sharedpref" path="jarvis_secure_keystore_vault.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- API keys remain on the source device and must be entered again after transfer. -->
        <exclude domain="sharedpref" path="jarvis_secure_keystore_vault.xml" />
    </device-transfer>
</data-extraction-rules>
